{
  "family": "mining-marketplace-backend-production",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::514671607568:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::514671607568:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "mining-marketplace-backend",
      "image": "514671607568.dkr.ecr.us-east-1.amazonaws.com/mining-marketplace-backend:production",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4000,
          "hostPort": 4000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "4000"
        }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:514671607568:parameter/mining-marketplace/production/database-url"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-1:514671607568:parameter/mining-marketplace/production/jwt-secret"
        },
        {
          "name": "STRIPE_SECRET_KEY",
          "valueFrom": "arn:aws:ssm:us-east-1:514671607568:parameter/mining-marketplace/production/stripe-secret-key"
        },
        {
          "name": "FLUTTERWAVE_SECRET_KEY",
          "valueFrom": "arn:aws:ssm:us-east-1:514671607568:parameter/mining-marketplace/production/flutterwave-secret-key"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mining-marketplace-backend-production",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:4000/api/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "2048",
  "memory": "4096"
}
